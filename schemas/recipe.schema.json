{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secretctl.dev/schemas/recipe.schema.json",
  "title": "SiteRecipe",
  "description": "Schema for deterministic browser interaction recipes. Predefined selectors and execution constraints.",
  "type": "object",
  "properties": {
    "recipe_id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string" },
    "action": {
      "type": "string",
      "enum": [
        "authenticate.password",
        "authenticate.totp",
        "form.sensitive_fill",
        "oauth.authorize"
      ]
    },
    "match": {
      "type": "object",
      "properties": {
        "top_origin": { "type": "string" },
        "path_prefix": { "type": "string", "pattern": "^/" },
        "frame_origin": { "type": "string" }
      },
      "required": ["top_origin"],
      "additionalProperties": false
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": { "type": "string", "minLength": 1, "maxLength": 64 },
          "selector": { "type": "string", "minLength": 1 },
          "optional": { "type": "boolean" },
          "clear_first": { "type": "boolean" }
        },
        "required": ["role", "selector"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 5
    },
    "submit": {
      "type": "object",
      "properties": {
        "selector": { "type": "string" },
        "auto_submit": { "type": "boolean" },
        "delay_ms": { "type": "integer", "minimum": 0, "maximum": 5000 }
      },
      "additionalProperties": false
    },
    "success_indicators": {
      "type": "object",
      "properties": {
        "navigation_origin": { "type": "string" },
        "selector_present": { "type": "string" },
        "selector_absent": { "type": "string" },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 30000 }
      },
      "additionalProperties": false
    },
    "oauth": {
      "type": "object",
      "properties": {
        "issuer": { "type": "string" },
        "authorization_endpoint": { "type": "string", "format": "uri" },
        "token_endpoint": { "type": "string", "format": "uri" },
        "client_id": { "type": "string", "minLength": 1 },
        "redirect_uri": { "type": "string", "format": "uri" },
        "allowed_scopes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\S+$" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["issuer", "authorization_endpoint", "token_endpoint", "client_id", "redirect_uri", "allowed_scopes"],
      "additionalProperties": false
    }
  },
  "required": ["recipe_id", "version", "name", "action", "match", "fields"],
  "allOf": [
    {
      "if": {
        "properties": { "action": { "const": "oauth.authorize" } },
        "required": ["action"]
      },
      "then": {
        "properties": { "fields": { "maxItems": 0 } },
        "required": ["oauth"]
      },
      "else": {
        "properties": { "fields": { "minItems": 1 } },
        "not": { "required": ["oauth"] }
      }
    }
  ],
  "additionalProperties": false
}
