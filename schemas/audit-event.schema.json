{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secretctl.dev/schemas/audit-event.schema.json",
  "title": "AuditEvent",
  "description": "Tamper-evident audit record schema with cryptographic hash chaining.",
  "type": "object",
  "properties": {
    "sequence": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string" },
    "event_type": {
      "type": "string",
      "enum": [
        "agent.enrolled",
        "agent.connected",
        "action.requested",
        "policy.evaluated",
        "approval.challenged",
        "approval.requested",
        "approval.decided",
        "approval.approved",
        "approval.denied",
        "approval.expired",
        "approval.invalidated",
        "capability.minted",
        "capability.consumed",
        "capability.revoked",
        "capability.expired",
        "secret.accessed",
        "executor.started",
        "executor.completed",
        "executor.failed",
        "execution.completed",
        "execution.failed",
        "secret.retrieve_succeeded",
        "policy.reloaded",
        "browser.stale",
        "audit.checkpoint",
        "session.invalidated",
        "security.violation"
      ]
    },
    "actor_type": { "type": "string", "enum": ["agent", "user", "broker", "executor"] },
    "actor_id": { "type": ["string", "null"] },
    "event_json": { "type": "string", "description": "Canonical JSON audit context; prohibited secret-bearing keys are rejected before storage" },
    "audit_key_version": { "type": "integer", "minimum": 1 },
    "previous_hash": { "type": "string", "description": "Encoded HMAC-SHA-256 hash of previous audit event" },
    "event_hash": { "type": "string", "description": "Encoded HMAC-SHA-256 hash of current audit event" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": [
    "sequence",
    "event_id",
    "event_type",
    "actor_type",
    "event_json",
    "audit_key_version",
    "previous_hash",
    "event_hash",
    "created_at"
  ],
  "additionalProperties": false
}
