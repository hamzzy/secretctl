<?xml version="1.0" encoding="UTF-8"?>
<!--
  Launch agent for the secretctl menu-bar application.

  This starts the UI only. The security daemon has its own agent
  (dev.secretctl.daemon) and must be able to run without this one: the desktop
  app is a client, and a machine with no UI running is still protected. The
  reverse is not true, which is why the app fails closed and says so when the
  daemon is unreachable.

  Install:
    cp desktop/launchd/dev.secretctl.desktop.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.secretctl.desktop.plist

  Remove:
    launchctl bootout gui/$(id -u)/dev.secretctl.desktop
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.secretctl.desktop</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/secretctl.app/Contents/MacOS/secretctl</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if it exits: an absent menu-bar icon is indistinguishable from
         "nothing is happening", which is the one thing it must never imply. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Back off rather than spinning if the app cannot start at all. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/tmp/secretctl-desktop.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/secretctl-desktop.log</string>
</dict>
</plist>
